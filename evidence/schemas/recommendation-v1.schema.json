{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spark-serve.invalid/evidence/recommendation-v1.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "recommendation"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "hardware_nodes": {
      "type": "integer",
      "minimum": 1
    },
    "selected": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "fingerprint"
      ],
      "additionalProperties": false
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "catalog_id": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "catalog_id",
          "rationale"
        ],
        "additionalProperties": false
      }
    },
    "evidence_runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "fingerprint"
        ],
        "additionalProperties": false
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "review": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "proposed",
            "reviewed"
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "basis",
        "date"
      ],
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "fingerprint",
    "model",
    "hardware_nodes",
    "selected",
    "alternatives",
    "evidence_runs",
    "rationale",
    "review",
    "limitations"
  ],
  "additionalProperties": false
}
