{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spark-serve.invalid/evidence/run-v1.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "run"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "origin": {
      "enum": [
        "local",
        "historical_import",
        "external_report"
      ]
    },
    "recorded_at": {
      "type": "string",
      "minLength": 1
    },
    "executed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "recipe": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "fingerprint"
      ],
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "properties": {
        "relationship": {
          "enum": [
            "attested_exact",
            "historical_association",
            "external_report"
          ]
        },
        "image_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "runtime_revision": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "model_revision": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "attestation": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "relationship",
        "image_digest",
        "runtime_revision",
        "model_revision",
        "attestation"
      ],
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "properties": {
        "hardware": {
          "type": "object"
        },
        "software": {
          "type": "object"
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "hardware",
        "software",
        "unknowns"
      ],
      "additionalProperties": false
    },
    "workload_version": {
      "type": "string",
      "minLength": 1
    },
    "measurements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "metric": {
            "enum": [
              "ttft",
              "response_latency",
              "decode_rate_proxy",
              "end_to_end_throughput",
              "reported_throughput",
              "correct",
              "cases",
              "reported_prompt_tokens"
            ]
          },
          "value": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "unit": {
            "enum": [
              "s",
              "tokens/s",
              "count",
              "tokens"
            ]
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "aggregation": {
            "enum": [
              "single",
              "median",
              "p95",
              "sum",
              "count",
              "reported_unknown"
            ]
          },
          "samples": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "sample_unit": {
            "type": "string",
            "minLength": 1
          },
          "population": {
            "type": "string",
            "minLength": 1
          },
          "conditions": {
            "type": "object",
            "properties": {
              "workload": {
                "type": "string",
                "minLength": 1
              },
              "fixture_sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "concurrency": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "cache": {
                "enum": [
                  "cold",
                  "warm",
                  "mixed",
                  "uncontrolled",
                  "unknown"
                ]
              },
              "request": {
                "type": "object"
              },
              "sampling": {
                "type": "object"
              },
              "warmup": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "workload",
              "fixture_sha256",
              "concurrency",
              "cache",
              "request",
              "sampling",
              "warmup"
            ],
            "additionalProperties": false
          },
          "source": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "path": {
                    "type": "array",
                    "items": {
                      "type": [
                        "string",
                        "integer"
                      ]
                    }
                  },
                  "original_file": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "file",
                  "sha256",
                  "path"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "metric",
          "value",
          "unit",
          "definition",
          "aggregation",
          "samples",
          "sample_unit",
          "population",
          "conditions",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "minLength": 1
          },
          "count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "category",
          "count",
          "detail"
        ],
        "additionalProperties": false
      }
    },
    "qualification": {
      "type": "object",
      "properties": {
        "build": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "passed",
                "failed",
                "not_tested",
                "unknown"
              ]
            },
            "scope": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "scope"
          ],
          "additionalProperties": false
        },
        "api_tool": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "passed",
                "failed",
                "not_tested",
                "unknown"
              ]
            },
            "scope": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "scope"
          ],
          "additionalProperties": false
        },
        "correctness": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "passed",
                "failed",
                "not_tested",
                "unknown"
              ]
            },
            "scope": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "scope"
          ],
          "additionalProperties": false
        },
        "clean_install": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "passed",
                "failed",
                "not_tested",
                "unknown"
              ]
            },
            "scope": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "scope"
          ],
          "additionalProperties": false
        },
        "restart": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "passed",
                "failed",
                "not_tested",
                "unknown"
              ]
            },
            "scope": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "scope"
          ],
          "additionalProperties": false
        },
        "reboot": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "passed",
                "failed",
                "not_tested",
                "unknown"
              ]
            },
            "scope": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "scope"
          ],
          "additionalProperties": false
        },
        "performance": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "passed",
                "failed",
                "not_tested",
                "unknown"
              ]
            },
            "scope": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "scope"
          ],
          "additionalProperties": false
        },
        "endurance": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "passed",
                "failed",
                "not_tested",
                "unknown"
              ]
            },
            "scope": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "scope"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "build",
        "api_tool",
        "correctness",
        "clean_install",
        "restart",
        "reboot",
        "performance",
        "endurance"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "path": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "integer"
              ]
            }
          },
          "original_file": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "file",
          "sha256",
          "path"
        ],
        "additionalProperties": false
      }
    },
    "external_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          }
        },
        "required": [
          "url",
          "revision"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "accounting": {
      "type": "object",
      "properties": {
        "requests_attempted": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "requests_completed": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "prompt_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "completion_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cached_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "wall_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "requests_attempted",
        "requests_completed",
        "prompt_tokens",
        "completion_tokens",
        "cached_tokens",
        "wall_seconds"
      ],
      "additionalProperties": false
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fixture_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "prompt_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "completion_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "cached_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "ttft_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "response_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "decode_rate_proxy": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "outcome": {
            "enum": [
              "passed_basic_gate",
              "failed"
            ]
          }
        },
        "required": [
          "fixture_sha256",
          "prompt_tokens",
          "completion_tokens",
          "cached_tokens",
          "ttft_seconds",
          "response_seconds",
          "decode_rate_proxy",
          "outcome"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "fingerprint",
    "origin",
    "recorded_at",
    "executed_at",
    "recipe",
    "identity",
    "environment",
    "workload_version",
    "measurements",
    "failures",
    "qualification",
    "sources",
    "external_sources",
    "limitations",
    "accounting",
    "observations"
  ],
  "additionalProperties": false
}
