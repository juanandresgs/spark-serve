+package config
+
+import (
+	"fmt"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"strings"
+	"testing"
+)
+
+func TestConfig_SelectorReadyOnly_Validation(t *testing.T) {
+	for _, tc := range []struct{ strategy, targets, wantErr string }{
+		{"ready", "a, b", ""},
+
+		{"ready", "a, remote/model", "requires local targets"},
+	} {
+		t.Run(tc.strategy+tc.targets, func(t *testing.T) {
+			cfg, err := LoadConfigFromReader(strings.NewReader(fmt.Sprintf(`
+models:
+  a: {cmd: "echo ${PORT}"}
+  b: {cmd: "echo ${PORT}"}
+groups:
+  pool: {swap: false, members: [a, b]}
+peers:
+  remote: {proxy: "http://example.com", models: [model]}
+selectors:
+  pool:
+    strategy: %s
+    targets: [%s]
+    settings: {spillover: 1}
+`, tc.strategy, tc.targets)))
+			if tc.wantErr != "" {
+				require.Error(t, err)
+				assert.Contains(t, err.Error(), tc.wantErr)
+			} else {
+				require.NoError(t, err)
+				assert.Equal(t, SelectorStrategyReady, cfg.Selectors["pool"].Strategy)
+			}
+		})
+	}
+}
