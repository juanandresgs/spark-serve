+package server
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/mostlygeek/llama-swap/internal/config"
+	"github.com/mostlygeek/llama-swap/internal/process"
+	"github.com/mostlygeek/llama-swap/internal/swaputil"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestServer_SelectorReadyOnly_StartingPeerNeverTakesBusyReadyTraffic(t *testing.T) {
+	cfg := selectorTestConfig(t)
+	selector := cfg.Selectors["balanced"]
+	selector.Strategy = config.SelectorStrategyReady
+	cfg.Selectors["balanced"] = selector
+	tracker := newSelectorSpilloverTracker(cfg)
+	states := map[string]process.ProcessState{"a": process.StateReady, "b": process.StateStarting, "c": process.StateStopped}
+	for i := 0; i < 20; i++ {
+		target, err := strategySpillover("balanced", tracker, states)
+		require.NoError(t, err)
+		assert.Equal(t, "a", target)
+	}
+	// When B actually becomes ready it participates in least-inflight balance.
+	states["b"] = process.StateReady
+	target, err := strategySpillover("balanced", tracker, states)
+	require.NoError(t, err)
+	assert.Equal(t, "b", target)
+	// A returning to starting cannot be selected, even with old reservations.
+	states["a"] = process.StateStarting
+	target, err = strategySpillover("balanced", tracker, states)
+	require.NoError(t, err)
+	assert.Equal(t, "b", target)
+}
+
+func TestServer_SelectorReadyOnly_FailsBeforeDownstreamWhenNoneReady(t *testing.T) {
+	for _, state := range []process.ProcessState{process.StateStarting, process.StateStopped, process.StateStopping, process.StateShutdown} {
+		t.Run(string(state), func(t *testing.T) {
+			cfg := selectorTestConfig(t)
+			selector := cfg.Selectors["balanced"]
+			selector.Strategy = config.SelectorStrategyReady
+			cfg.Selectors["balanced"] = selector
+			local := newStubRouter([]string{"a", "b", "c"}, "")
+			local.running = map[string]process.ProcessState{"a": state, "b": state}
+			called := false
+			local.serveHTTP = func(w http.ResponseWriter, r *http.Request) { called = true }
+			s := selectorTestServer(t, cfg, local)
+			w := httptest.NewRecorder()
+			s.ServeHTTP(w, chatRequest("balanced"))
+			assert.Equal(t, http.StatusServiceUnavailable, w.Code)
+			assert.False(t, called, "must not enter a downstream path that could start a model")
+		})
+	}
+}
+
+func TestServer_SelectorReadyOnly_StreamsAndNonstreamsUseReadyPeer(t *testing.T) {
+	for _, stream := range []bool{false, true} {
+		cfg := selectorTestConfig(t)
+		selector := cfg.Selectors["balanced"]
+		selector.Strategy = config.SelectorStrategyReady
+		cfg.Selectors["balanced"] = selector
+		local := newStubRouter([]string{"a", "b", "c"}, "")
+		local.running = map[string]process.ProcessState{"a": process.StateStarting, "b": process.StateReady}
+		local.serveHTTP = func(w http.ResponseWriter, r *http.Request) {
+			data, _ := swaputil.ReadContext(r.Context())
+			assert.Equal(t, "b", data.ModelID)
+			if stream {
+				w.Header().Set("Content-Type", "text/event-stream")
+				_, _ = w.Write([]byte("data: {\"choices\":[{\"delta\":{\"content\":\"OK\"}}]}\n\ndata: [DONE]\n\n"))
+			} else {
+				w.Header().Set("Content-Type", "application/json")
+				_, _ = w.Write([]byte("{\"choices\":[{\"message\":{\"content\":\"OK\"}}]}"))
+			}
+		}
+		s := selectorTestServer(t, cfg, local)
+		w := httptest.NewRecorder()
+		req := httptest.NewRequest(http.MethodPost, "/v1/chat/completions", strings.NewReader(`{"model":"balanced","stream":`+strconv.FormatBool(stream)+`,"messages":[{"role":"user","content":"test"}]}`))
+		req.Header.Set("Content-Type", "application/json")
+		s.ServeHTTP(w, req)
+		assert.Equal(t, http.StatusOK, w.Code)
+		assert.Contains(t, w.Body.String(), "OK")
+	}
+}
+
+// Native maintenance profile changes affect new admission, not existing streams.
+func TestServer_SelectorReadyOnly_MaintenanceProfilePreservesActiveStream(t *testing.T) {
+	cfg := selectorTestConfig(t)
+	selector := cfg.Selectors["balanced"]
+	selector.Strategy = config.SelectorStrategyReady
+	cfg.Selectors["balanced"] = selector
+	selector.Targets = []string{"b"}
+	selector.Unlisted = true
+	cfg.Selectors["only-b"] = selector
+	cfg.Profiles["maintenance"] = config.ProfileConfig{Pins: map[string]string{"balanced": "only-b"}}
+	local := newStubRouter([]string{"a", "b", "c"}, "")
+	local.running = map[string]process.ProcessState{"a": process.StateReady, "b": process.StateReady}
+	started, release, done := make(chan struct{}), make(chan struct{}), make(chan struct{})
+	local.serveHTTP = func(w http.ResponseWriter, r *http.Request) {
+		data, _ := swaputil.ReadContext(r.Context())
+		if data.ModelID == "a" {
+			close(started)
+			<-release
+		}
+		_, _ = w.Write([]byte(data.ModelID))
+	}
+	s := selectorTestServer(t, cfg, local)
+	first := httptest.NewRecorder()
+	go func() { defer close(done); s.ServeHTTP(first, chatRequest("balanced")) }()
+	<-started
+	activation := httptest.NewRecorder()
+	s.ServeHTTP(activation, httptest.NewRequest(http.MethodPut, "/api/profiles/active", strings.NewReader(`{"name":"maintenance"}`)))
+	require.Equal(t, http.StatusOK, activation.Code)
+	next := httptest.NewRecorder()
+	s.ServeHTTP(next, chatRequest("balanced"))
+	assert.Equal(t, "b", next.Body.String())
+	close(release)
+	<-done
+	assert.Equal(t, http.StatusOK, first.Code)
+	assert.Equal(t, "a", first.Body.String())
+	assert.Equal(t, process.StateReady, local.running["a"])
+	assert.Equal(t, process.StateReady, local.running["b"])
+}
