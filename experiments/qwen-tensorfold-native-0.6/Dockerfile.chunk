ARG PARENT_IMAGE
FROM ${PARENT_IMAGE}
ARG TENSORFOLD_REV=c4646171139ee8a3c38103eaa1699dad226ec12b
ENV TF_FLASH_DECODE_BURST=4 \
    TF_FLASH_PREFILL_ROWS=1024
LABEL org.opencontainers.image.source="https://github.com/ashhart/TensorFold" \
      org.opencontainers.image.revision="${TENSORFOLD_REV}" \
      org.opencontainers.image.description="Experimental cancellation plus EXL3 burst-4 and 1024-row prefill derivative" \
      org.dgx-spark-serve.tensorfold.variant="experimental-native-prefill-cancellation-decode-burst4-prefill1024" \
      org.dgx-spark-serve.tensorfold.prefill-rows-patch-sha256="b791de1d03eed4047c522f33e6f212796c66461794040507ebcff276e1a69e77"

COPY decode-burst/patch-manifest.json /opt/spark-serve/scheduling/burst-patch-manifest.json
COPY scheduling/chunk/prefill-rows.patch scheduling/chunk/patch-manifest.json scheduling/chunk/test_prefill_rows.py /opt/spark-serve/scheduling/chunk/
RUN python - <<'PY'
import hashlib, json, pathlib, subprocess
root = pathlib.Path('/opt/spark-serve/scheduling')
burst = json.loads((root / 'burst-patch-manifest.json').read_text())
chunk = json.loads((root / 'chunk/patch-manifest.json').read_text())
assert chunk['upstream_commit'] == 'c4646171139ee8a3c38103eaa1699dad226ec12b'
assert chunk['parent_burst_patch_sha256'] == burst['patch_sha256']
src = pathlib.Path('/opt/tensorfold-source')
assert subprocess.check_output(['git', '-C', str(src), 'rev-parse', 'HEAD'], text=True).strip() == chunk['upstream_commit']
for rel, info in burst['files'].items():
    assert hashlib.sha256((src / rel).read_bytes()).hexdigest() == info['after_sha256'], rel
for rel, info in chunk['files'].items():
    assert hashlib.sha256((src / rel).read_bytes()).hexdigest() == info['before_sha256'], rel
patch = root / 'chunk/prefill-rows.patch'
assert hashlib.sha256(patch.read_bytes()).hexdigest() == chunk['patch_sha256']
PY
RUN cd /opt/tensorfold-source && \
    git apply --check /opt/spark-serve/scheduling/chunk/prefill-rows.patch && \
    git apply /opt/spark-serve/scheduling/chunk/prefill-rows.patch && \
    python -m pip install --no-deps --no-build-isolation --no-cache-dir . && \
    python - <<'PY'
import hashlib, json, pathlib, tensorfold
m = json.loads(pathlib.Path('/opt/spark-serve/scheduling/chunk/patch-manifest.json').read_text())
src = pathlib.Path(tensorfold.__file__).resolve().parent.parent
for rel, info in m['files'].items():
    assert hashlib.sha256((src / rel.removeprefix('src/')).read_bytes()).hexdigest() == info['after_sha256'], rel
PY
COPY scheduling/chunk/README.md /opt/spark-serve/scheduling/chunk/README.md
